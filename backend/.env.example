# Copy to .env and edit. Never commit the real .env.
# Leave DATABASE_URL empty to use a local SQLite file.
# PostgreSQL example: postgresql+psycopg2://healthwise:healthwise@localhost:5432/healthwise
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
LLM_API_KEY=
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# Optional: full path to tesseract.exe if it is not on PATH (Windows)
TESSERACT_CMD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The letterhead of printed prescriptions (leave empty to show none of it)
HOSPITAL_NAME=
HOSPITAL_ADDRESS=
HOSPITAL_PHONE=
HOSPITAL_EMAIL=

# Starting password of every new account (the person must change it at the first login). Needs a letter and a number, 8+ characters.
# DEFAULT_PASSWORD=Welcome@123

# Sign in with a mobile number: there is no SMS provider yet. true shows the code on the login screen. Keep it false outside a local demo.
OTP_DEMO_MODE=false
