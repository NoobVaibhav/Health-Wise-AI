{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run API",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: run dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: run tests",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: seed demo accounts",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m app.seed_demo",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Run everything (backend + frontend)",
      "dependsOn": ["Backend: run API", "Frontend: run dev server"],
      "problemMatcher": []
    }
  ]
}
